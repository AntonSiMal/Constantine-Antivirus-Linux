#!/usr/bin/env python3
"""
Constantine Antivirus - Privileged Helper Wrapper (service/constantine-helper)
Ejecutable restringido invocado a través de Polkit (pkexec) para operaciones administrativas específicas.
Principio de Mínimo Privilegio: Solo ejecuta operaciones predefinidas con validación estricta
de argumentos y sin intermediación de intérpretes de shell.
"""
import os
import sys
import re
import subprocess

def die(msg: str):
    sys.stderr.write(f"ERROR: {msg}\n")
    sys.exit(1)

def validate_path(p: str) -> str:
    if not p or not isinstance(p, str) or "\x00" in p or len(p) > 4096:
        die("Ruta inválida")
    norm = os.path.normpath(p)
    if not os.path.isabs(norm):
        die("Ruta debe ser absoluta")
    return norm

def validate_vault_id(vid: str) -> str:
    if not vid or not isinstance(vid, str) or not re.match(r"^[0-9a-fA-F]{16,64}$", vid.strip()):
        die("Identificador de cuarentena inválido")
    return vid.strip()

def main():
    if len(sys.argv) < 2:
        die("Comando requerido")

    action = sys.argv[1].strip()

    if action == "admin-unlock":
        # Autorización de desbloqueo exitosa verificada por Polkit
        print("ADMIN_UNLOCKED")
        sys.exit(0)

    elif action == "service-manage":
        if len(sys.argv) < 3:
            die("Subcomando de servicio requerido")
        subcmd = sys.argv[2].strip()
        if subcmd not in ("restart", "status"):
            die("Subcomando de servicio no permitido")
        res = subprocess.run(["systemctl", subcmd, "constantine.service"], shell=False)
        sys.exit(res.returncode)

    elif action == "quarantine-manage":
        if len(sys.argv) < 3:
            die("Subcomando de cuarentena requerido")
        subcmd = sys.argv[2].strip()
        from core.engine.ipc_protocol import SecureIPCClient
        client = SecureIPCClient()
        if subcmd == "purge":
            resp = client.send_command("PURGE_QUARANTINE")
            if resp.get("status") == "OK":
                print("Cuarentena purgada exitosamente.")
                sys.exit(0)
            else:
                die(f"Fallo al purgar cuarentena: {resp.get('error')}")
        elif subcmd == "restore":
            if len(sys.argv) < 4:
                die("vault_id requerido para restauración")
            vid = validate_vault_id(sys.argv[3])
            dest = validate_path(sys.argv[4]) if len(sys.argv) >= 5 else None
            resp = client.send_command("RESTORE_QUARANTINE", {"vault_id": vid, "destination": dest})
            if resp.get("status") == "OK":
                print("Muestra restaurada exitosamente.")
                sys.exit(0)
            else:
                die(f"Fallo al restaurar muestra: {resp.get('error')}")
        else:
            die("Subcomando de cuarentena no reconocido")

    elif action == "whitelist-manage":
        if len(sys.argv) < 4:
            die("Subcomando y ruta requeridos")
        subcmd = sys.argv[2].strip()
        path = validate_path(sys.argv[3])
        from core.engine.ipc_protocol import SecureIPCClient
        client = SecureIPCClient()
        if subcmd == "add":
            resp = client.send_command("ADD_WHITELIST", {"path": path})
        elif subcmd == "remove":
            resp = client.send_command("REMOVE_WHITELIST", {"path": path})
        else:
            die("Subcomando de lista blanca no reconocido")
        sys.exit(0 if resp.get("status") == "OK" else 1)

    elif action == "shield-toggle":
        if len(sys.argv) < 4:
            die("Identificador de escudo y estado requeridos")
        shield_id = sys.argv[2].strip()
        enable_str = sys.argv[3].strip().lower() in ("true", "1", "yes")
        from core.engine.ipc_protocol import SecureIPCClient
        client = SecureIPCClient()
        resp = client.send_command("TOGGLE_SHIELD", {"shield_id": shield_id, "enable": enable_str})
        sys.exit(0 if resp.get("status") == "OK" else 1)

    elif action == "dns-apply":
        if len(sys.argv) < 3:
            die("Perfil de DNS requerido")
        profile = sys.argv[2].strip()
        from core.engine.ipc_protocol import SecureIPCClient
        client = SecureIPCClient()
        resp = client.send_command("APPLY_DNS_PROFILE", {"profile": profile})
        sys.exit(0 if resp.get("status") == "OK" else 1)

    elif action == "update-apply":
        from core.engine.auto_updater import ConstantineUpdater
        cu = ConstantineUpdater()
        info = cu.check_for_updates()
        if info.get("has_update"):
            ok, msg = cu.download_and_apply_update(info["download_url"], info["expected_sha256"])
            sys.exit(0 if ok else 1)
        sys.exit(0)

    elif action == "uninstall":
        if os.path.exists("/opt/constantine/uninstall.sh"):
            res = subprocess.run(["/bin/bash", "/opt/constantine/uninstall.sh", "-y"], shell=False)
            sys.exit(res.returncode)
        die("Script de desinstalación no encontrado")

    else:
        die(f"Acción no reconocida: {action}")

if __name__ == "__main__":
    main()
