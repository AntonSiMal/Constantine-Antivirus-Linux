[Unit]
Description=Constantine Antivirus - Active Kernel Defense Service
After=network.target local-fs.target
Before=sysinit.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/constantine
ExecStart=/usr/bin/python3 /opt/constantine/daemon.py --watch-dir=/tmp --enable-firewall
Restart=always
RestartSec=3s
ProtectSystem=full
LimitNOFILE=65536

[Install]
WantedBy=sysinit.target multi-user.target
