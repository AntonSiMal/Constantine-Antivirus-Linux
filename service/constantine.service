[Unit]
Description=Constantine Antivirus & Security Observability Daemon
Documentation=https://github.com/AntonSiMal/Constantine-Antivirus-Linux
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/constantine/daemon.py --service
Restart=always
RestartSec=5s

# 1. Identidad del proceso y aislamiento de privilegios
User=root
Group=root

# 2. NoNewPrivileges: Impide que el servicio y sus hijos ganen nuevos privilegios vía setuid/setgid
NoNewPrivileges=true

# 3. Aislamiento del Sistema de Archivos
# Protege /usr, /boot y /etc contra escritura no autorizada
ProtectSystem=strict

# Protege los directorios de usuario (/home, /root, /run/user) en modo solo lectura de base.
# Se garantiza que ningún componente del servicio pueda escribir arbitrariamente en /home.
ProtectHome=read-only

# Directorios de escritura estrictamente delimitados a la infraestructura interna del servicio:
# - Infraestructura interna: /var/lib/constantine (Baúl y metadatos), /var/log/constantine (Logs), /run/constantine (Socket IPC), /etc/constantine (Claves)
# - Se EXCLUYE expresamente /home para impedir que el demonio o componentes potencialmente
#   comprometidos dispongan de permisos de escritura arbitrarios sobre archivos personales.
# - ProtectHome=read-only permanece inalterado y efectivo sobre toda la jerarquía de usuarios.
ReadWritePaths=/var/lib/constantine /var/log/constantine /run/constantine /etc/constantine

# Directorios del programa protegidos en modo solo lectura
ReadOnlyPaths=/opt/constantine /usr /etc /boot

# 4. Sandboxing y Protección de Kernel
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# 5. Restricción de Familias de Direcciones y Dispositivos
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/net/tun rw
DeviceAllow=char-video4linux r
DeviceAllow=char-alsa r
DeviceAllow=block-* r

# 6. Restricción Estricta de Capacidades Linux (Capability Bounding Set & AmbientCapabilities)
# Solo conserva las capacidades estrictamente requeridas por el motor de kernel, eBPF y red:
# - CAP_SYS_ADMIN: Requerido por fanotify (FAN_CLASS_CONTENT) y attach de sondas eBPF
# - CAP_NET_ADMIN: Requerido para aislamiento de red y corte de sockets mediante nftables/ss
# - CAP_KILL: Requerido para contención inmediata SIGKILL de ransomware y procesos hostiles
# - CAP_DAC_READ_SEARCH: Inspección forense y lectura de muestras (SIN CAP_DAC_OVERRIDE)
# - CAP_BPF / CAP_PERFMON: Sondas eBPF de kernel y buffers de rendimiento
# - CAP_SYS_PTRACE: Inspección de mapas de memoria (/proc/<pid>/maps)
# - CAP_SYS_RESOURCE: Ajuste de límites de memoria bloqueada en kernel para mapas eBPF
# ELIMINADAS EXPRESAMENTE:
# - CAP_DAC_OVERRIDE: Impide que el servicio eluda los permisos de escritura del sistema de archivos
# - CAP_NET_RAW: Impide la creación arbitraria de sockets raw
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_KILL CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_SYS_RESOURCE
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_KILL CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_SYS_RESOURCE

# 7. Filtrado Restrictivo de Llamadas al Sistema (SystemCallFilter)
# Bloquea grupos de llamadas al sistema innecesarias o peligrosas y restringe arquitectura
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged @reboot @swap
SystemCallArchitectures=native

# 8. Directorios de Estado y Ejecución
StateDirectory=constantine
RuntimeDirectory=constantine
LogsDirectory=constantine
ConfigurationDirectory=constantine

# Límites de Recursos para el Servicio
LimitNOFILE=65536
LimitMEMLOCK=infinity
MemoryMax=1G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
