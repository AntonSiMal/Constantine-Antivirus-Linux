[Unit]
Description=Constantine Antivirus & Security Observability Daemon
Documentation=https://github.com/AntonSiMal/Constantine-Antivirus-Linux
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/constantine/daemon.py --service
Restart=always
RestartSec=5s

# 1. Identidad del proceso y aislamiento de privilegios
User=root
Group=root

# 2. NoNewPrivileges: Impide que el servicio y sus hijos ganen nuevos privilegios vía setuid/setgid
NoNewPrivileges=true

# 3. Aislamiento del Sistema de Archivos con Separación de Planos
# ProtectSystem=full protege /usr y /boot en modo solo lectura para resguardar binarios de sistema.
ProtectSystem=full

# Supervisión de archivos personales:
# ProtectHome=false permite que los centinelas y fanotify supervisen /home, /root y /run/user sin bloquear acceso.
ProtectHome=false

# Directorios de escritura delimitados con estricta separación:
# - Infraestructura interna: /var/lib/constantine (Baúl y metadatos), /var/log/constantine (Logs), /run/constantine (Socket IPC), /etc/constantine (Claves)
# - Planos de supervisión y remediación controlada: /home y /tmp
ReadWritePaths=/var/lib/constantine /var/log/constantine /run/constantine /etc/constantine /home /tmp

# Directorios de binarios de la aplicación protegidos en modo solo lectura
ReadOnlyPaths=/opt/constantine /usr /boot

# 4. Sandboxing y Protección de Kernel compatible con eBPF y Observabilidad
# PrivateTmp=false permite vigilar y contener amenazas en el /tmp real compartido del host
PrivateTmp=false
ProtectKernelTunables=true
# ProtectKernelModules=true: Protege el kernel contra inserción no autorizada de módulos (.ko/rootkits).
# eBPF no requiere módulos del kernel; opera vía bpf() y tracepoints sin comprometer la integridad modular.
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# 5. Restricción de Familias de Direcciones y Dispositivos
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/net/tun rw
DeviceAllow=char-video4linux r
DeviceAllow=char-alsa r
DeviceAllow=block-* r

# 6. Conjunto de Capacidades Linux para EDR (Separación Inspección vs Remediación)
# - Plano de Inspección Continua: CAP_DAC_READ_SEARCH (lectura forense en todo el FS), CAP_SYS_PTRACE (mapas /proc)
# - Plano de Instrumentación eBPF: CAP_BPF, CAP_PERFMON, CAP_IPC_LOCK (y CAP_SYS_ADMIN como compatibilidad kernel < 5.8)
# - Plano de Remediación Concurrente y Focalizada: CAP_DAC_OVERRIDE (delegado a proceso aislado para cuarentena), CAP_KILL (SIGKILL), CAP_NET_ADMIN (aislamiento de red)
# NOTA: En instalaciones con kernel >= 5.8, install.sh retira dinámicamente CAP_SYS_ADMIN para asegurar mínimo privilegio.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_KILL CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_SYS_RESOURCE CAP_IPC_LOCK
# AmbientCapabilities acotadas estrictamente: CAP_DAC_OVERRIDE no se hereda como ambiente permanente a hijos/workers
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_KILL CAP_DAC_READ_SEARCH CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_SYS_RESOURCE CAP_IPC_LOCK

# 7. Filtrado Restrictivo de Llamadas al Sistema (SystemCallFilter)
# Semántica combinada de systemd con cálculo formal de conjuntos efectivos:
# - @system-service: Requerido para ciclo de vida del demonio, señales, hebras, memoria y socket IPC Unix (/run/constantine).
# - @network-io: Requerido para feeds de amenazas (MISP, VirusTotal), perfiles DNS activos y telemetría.
# - @file-system: Requerido para supervisión on-access, lectura forense de directorios y cuarentena atómica.
# - bpf, perf_event_open, fanotify_init, fanotify_mark: Syscalls indispensables para observabilidad y bloqueo preventivo.
# - ~@obsolete @reboot @swap: Denegación estricta de ABI de kernel obsoleto y llamadas de reinicio o swapping destructivas.
SystemCallFilter=@system-service @network-io @file-system bpf perf_event_open fanotify_init fanotify_mark
SystemCallFilter=~@obsolete @reboot @swap
SystemCallArchitectures=native

# 8. Directorios de Estado y Ejecución
StateDirectory=constantine
RuntimeDirectory=constantine
LogsDirectory=constantine
ConfigurationDirectory=constantine

# Límites de Recursos para el Servicio
LimitNOFILE=65536
LimitMEMLOCK=infinity
MemoryMax=1G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
