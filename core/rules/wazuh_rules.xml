<group name="constantine,fim,yara,">
  <rule id="100201" level="3">
    <if_sid>550</if_sid>
    <field name="file">/home/|/tmp/|/var/tmp/</field>
    <description>FIM: Archivo modificado detectado en directorio supervisado</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <active_response>trigger_yara_scan</active_response>
  </rule>

  <rule id="100202" level="12">
    <if_group>yara_detection</if_group>
    <description>Wazuh FIM+YARA: Shell reversa o agente C2 detectado en archivo nuevo o modificado</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1071.001</id>
    </mitre>
    <active_response>quarantine_vault_and_firewall_drop</active_response>
  </rule>

  <rule id="100203" level="8">
    <field name="file">/etc/|/boot/|/bin/|/sbin/</field>
    <description>FIM: Modificación no autorizada en binario o configuración crítica de sistema</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <active_response>quarantine_vault</active_response>
  </rule>

  <rule id="100204" level="10">
    <if_group>fim_integrity</if_group>
    <field name="file">.ssh/authorized_keys</field>
    <description>FIM: Inyección o alteración de llaves SSH autorizadas</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
    <active_response>quarantine_vault_and_firewall_drop</active_response>
  </rule>

  <rule id="100205" level="6">
    <if_group>download_event</if_group>
    <description>FIM: Nueva descarga finalizada en directorio supervisado</description>
    <active_response>trigger_yara_scan</active_response>
  </rule>

  <rule id="100206" level="14">
    <if_group>ransomware_burst</if_group>
    <description>Ransomware: Modificación masiva o cifrado anómalo de extensiones</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <active_response>quarantine_vault_and_firewall_drop</active_response>
  </rule>

  <rule id="100207" level="7">
    <if_group>usb_storage</if_group>
    <description>FIM: Dispositivo extraíble USB montado para inspección</description>
    <active_response>trigger_yara_scan</active_response>
  </rule>
</group>
